# Local infrastructure only. Do not place production credentials in this file.
POSTGRES_DB=cloudguard
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=5173

# API configuration
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://cloudguard:change-me-for-local-development@postgres:5432/cloudguard
REDIS_URL=redis://redis:6379/0

# Local development AWS CLI profile mount. Set AWS_CONFIG_DIR in your ignored
# .env file to the directory containing your credentials and config files.
AWS_PROFILE=default
AWS_CONFIG_DIR=./.aws
